# ==============================================================
# YYC³ manju-studio 后端环境模板（M1）
# 使用：cp .env.example .env 并按环境调整；uvicorn/celery 经环境变量读取
# ==============================================================

# 运行环境：dev（开发态身份存根）/ prod（M4 起强制网关鉴权）
MANJU_ENV=dev

# Redis（Celery broker/backend + 健康检查）
REDIS_URL=redis://localhost:6379/0

# 数据库（M2 启用；M1 留空即跳过，不影响服务）
# DATABASE_URL=postgresql+psycopg://manju:manju_local_dev@localhost:5432/manju

# 0379-world 网关（M4 鉴权收口）
GATEWAY_URL=http://localhost:30001

# NAS 产出物根（留空默认仓内 storage/）
# NAS_PATH=/volume1/manju/storage
